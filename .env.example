# ---- LLM provider -------------------------------------------------------
# "openai" (default) uses the standard OpenAI API. Set "azure" to use an
# Azure OpenAI deployment (then fill AI_ENDPOINT / AI_API_VERSION below).
AI_PROVIDER=openai

# Standard OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# Azure-only (ignored when AI_PROVIDER=openai):
AI_API_KEY=
AI_ENDPOINT=
AI_API_VERSION=2025-01-01-preview

# ---- Models -------------------------------------------------------------
# Use real model ids for the active provider. For OpenAI: gpt-4o, gpt-4o-mini.
# (Azure deployment names like "gpt-5-mini" only work when AI_PROVIDER=azure.)
AI_MODEL=gpt-4o-mini
ROOT_MODEL=gpt-4o-mini
SQL_TASK_MODEL=gpt-4o
SQL_GENERATOR_MODEL=gpt-4o-mini
PLOT_CONFIG_MODEL=gpt-4o-mini
RESULT_INTERPRETER_MODEL=gpt-4o-mini

# ---- Database -----------------------------------------------------------
# Local dev: 127.0.0.1. Docker Compose: set MYSQL_HOST=db (the service name).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sakila
MYSQL_POOL_SIZE=5

DB_TYPE=mysql

# ---- App ----------------------------------------------------------------
ALLOWED_TABLES=actor,film
MAX_ROWS=200

# Server bind (Docker needs 0.0.0.0).
HOST=0.0.0.0
PORT=8080
# Set to 1 to let FastAPI serve the legacy static frontend/ (not needed when
# the Next.js app in web/ is running).
SERVE_STATIC=
